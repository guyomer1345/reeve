{
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "Task",
      "TodoWrite",
      "WebSearch",
      "WebFetch",
      "Bash"
    ],
    "ask": [
      "Bash(git remote add:*)",
      "Bash(git remote set-url:*)",
      "Bash(gh pr:*)",
      "Bash(gh release:*)",
      "Bash(gh repo:*)",
      "Bash(gh api:*)",
      "Bash(gh auth:*)",
      "Bash(gh secret:*)",
      "Bash(gh workflow:*)",
      "Bash(gh gist:*)",
      "Bash(npm publish:*)",
      "Bash(yarn publish:*)",
      "Bash(pnpm publish:*)",
      "Bash(npm run deploy:*)",
      "Bash(yarn run deploy:*)",
      "Bash(pnpm run deploy:*)",
      "Bash(npm run release:*)",
      "Bash(make deploy:*)",
      "Bash(make release:*)",
      "Bash(make publish:*)",
      "Bash(cargo publish:*)",
      "Bash(twine upload:*)",
      "Bash(gem push:*)",
      "Bash(docker push:*)",
      "Bash(docker login:*)",
      "Bash(kubectl:*)",
      "Bash(helm:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(pulumi up:*)",
      "Bash(pulumi destroy:*)",
      "Bash(serverless deploy:*)",
      "Bash(vercel:*)",
      "Bash(netlify deploy:*)",
      "Bash(fly deploy:*)",
      "Bash(flyctl deploy:*)",
      "Bash(heroku:*)",
      "Bash(railway:*)",
      "Bash(aws:*)",
      "Bash(gcloud:*)",
      "Bash(az:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python3 .claude/scripts/statusline.py"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/guard.sh" }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "clear",
        "hooks": [
          { "type": "command", "command": "python3 .claude/hooks/session_start.py" }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual",
        "hooks": [
          { "type": "command", "command": "python3 .claude/hooks/precompact.py" }
        ]
      },
      {
        "matcher": "auto",
        "hooks": [
          { "type": "command", "command": "python3 .claude/hooks/precompact.py" }
        ]
      }
    ]
  }
}
